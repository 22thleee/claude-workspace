# ── 환경변수 견본 파일 ──────────────────────────────
# 이 파일(.env.example)은 "형식만" 보여주는 견본입니다. 실제 키는 없습니다.
#
# 사용법:
#   1. 이 파일을 복사해서 이름을 .env 로 바꾸세요
#        (PowerShell)  Copy-Item .env.example .env
#   2. .env 파일을 열어 오른쪽 값에 실제 키를 넣으세요
#   3. .env 는 절대 공유하지 말고, git 에도 올리지 마세요 (.gitignore 에 등록됨)
# ────────────────────────────────────────────────────

# OpenRouter (AI 모델 호출용 API 키)  형식: sk-or-v1-...
OPENROUTER_API_KEY=

# Oracle 클라우드 서버
ORACLE_SERVER_HOST=            # 예: 123.45.67.89  또는  myserver.example.com
ORACLE_SERVER_USER=            # 예: ubuntu  또는  opc
# SSH 키는 파일로 관리합니다: ~/.ssh/oracle-server.key  (여기에 값으로 넣지 않음)

# WordPress (블로그 자동화용)
WORDPRESS_URL=                 # 예: https://myblog.com
WORDPRESS_USER=                # 관리자 아이디
WORDPRESS_APP_PASSWORD=        # 응용 프로그램 비밀번호 (일반 로그인 비번 아님)

# ────────────────────────────────────────────────────
# 포트폴리오 방명록 (Supabase)
#   - 로컬:  아래 두 값을 repo 루트의 .env.local 에 넣고
#            `node scripts/gen-config.mjs` 실행 → portfolio/config.js 생성
#   - Vercel: 같은 두 값을 프로젝트 Settings > Environment Variables 에 등록
#            (빌드 시 portfolio/config.js 가 자동 생성됨. vercel.json 의 buildCommand)
#   ※ anon key 는 브라우저에 노출되는 "공개" 키입니다. RLS 가 데이터를 보호합니다.
#     service_role 키·DB 비밀번호는 여기에 절대 넣지 마세요.
SUPABASE_URL=                  # 예: https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=             # eyJ... (anon / public 키)
